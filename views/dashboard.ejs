<%- include('./partials/header') %>
<!-- Personalized dashboard visible only after login -->
<div class="container">
<div class="row mb-4">
<div class="col-12">
<div class="card shadow-sm border-0 bg-white p-4">
<h3 class="text-primary m-0">Student Dashboard 📖</h3>
<p class="text-muted mb-0">Manage your listed textbook offers and track your purchase requests.</p>
<p class="text-muted mb-0">Welcome, <%= user ? (user.name || user.username) : 'Student' %>!</p>
</div>
</div>
</div>
<div class="row g-3">
<div class="col-md-4">
<div class="card shadow-sm text-center h-100 p-3">
<h5 class="card-title">Submit / Request Book</h5>
<p class="text-muted small">List a textbook for sale or place a request for a required book.</p>
<a href="/submit-request" class="btn btn-success mt-auto">+ New Request / Listing</a>
</div>
</div>
<div class="col-md-4">
<div class="card shadow-sm text-center h-100 p-3">
<h5 class="card-title">My Submissions</h5>
<p class="text-muted small">View your listed textbooks and active purchase requests.</p>
<h4 class="text-primary my-2"><%= myListedBooksCount + myRequestsCount %> Total Items</h4>
<a href="/my-submissions" class="btn btn-outline-primary mt-auto">View My Submissions</a>
</div>
</div>
<div class="col-md-4">
<div class="card shadow-sm text-center h-100 p-3">
<h5 class="card-title">Search &amp; Browse</h5>
<p class="text-muted small">Find course textbooks filtered by subject or price.</p>
<a href="/search" class="btn btn-outline-secondary mt-auto">Search Textbooks</a>
</div>
</div>
</div>
</div>
<%- include('./partials/footer') %>
 