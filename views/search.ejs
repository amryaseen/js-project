<%- include('./partials/header') %>

<div class="container mt-5 mb-5">
    <h2 class="mb-4 text-center">Search Books</h2>

  
    <div class="row justify-content-center mb-5">
        <div class="col-md-8">
            <div class="card shadow-sm border-0 bg-light">
                <div class="card-body p-4">
                    <form action="/search" method="GET" class="d-flex align-items-center">
                        <label for="subject" class="me-3 fw-bold d-none d-md-block">Search by subject:</label>
                        <input class="form-control me-2 form-control-lg" type="search" id="subject" name="subject" value="<%= searchTerm %>" placeholder="e.g. CS101">
                        <button class="btn btn-primary btn-lg px-4" type="submit">Search</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

   
    <div class="row g-4">
        <% if (books.length === 0) { %>
            
            <div class="col-12">
                <div class="alert alert-warning text-center fs-5 shadow-sm" role="alert">
                    No books found matching your search.
                </div>
            </div>
        <% } else { %>
            
            <% books.forEach(function(book) { %>
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm border-primary">
                        <div class="card-body d-flex flex-column">
                            <h4 class="card-title text-primary mb-3"><%= book.title %></h4>
                            <p class="card-text text-muted mb-2"><strong>Subject:</strong> <span class="badge bg-secondary"><%= book.subject %></span></p>
                            <p class="card-text fw-bold text-success fs-5 mb-4">Price: <%= book.price %> JD</p>
                            
                            
                            <a href="/book/<%= book.id %>" class="btn btn-outline-primary mt-auto w-100">View Details</a>
                        </div>
                    </div>
                </div>
            <% }); %>
        <% } %>
    </div>
</div>

<%- include('./partials/footer') %>