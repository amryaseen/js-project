<%- include('./partials/header') %>
<h1><%= t.cookiePrefTitle %></h1>
<p><%= t.currentTheme %><%= theme %></p>
<p><%= t.currentLanguage %><%= language %></p>
<% if (saved) { %>
<p style="color: green;"><%= t.preferencesSaved %></p>
<% } %>
<form action="/cookie-preference" method="POST">
<div>
<label for="theme"><%= t.themeLabel %></label>
<select id="theme" name="theme">
<option value="light" <%= theme === 'light' ? 'selected' : '' %>><%= t.light %></option>
<option value="dark" <%= theme === 'dark' ? 'selected' : '' %>><%= t.dark %></option>
</select>
</div>
<div>
<label for="language"><%= t.languageLabel %></label>
<select id="language" name="language">
<option value="en" <%= language === 'en' ? 'selected' : '' %>><%= t.english %></option>
<option value="ar" <%= language === 'ar' ? 'selected' : '' %>><%= t.arabic %></option>
</select>
</div>
<button type="submit"><%= t.savePreferences %></button>
</form>
<%- include('./partials/footer') %>