<%- include('./partials/header') %>
<div class="container mt-5 mb-5">
<h2 class="text-center mb-5 pb-2 border-bottom"><%= t.availableBooks %></h2>

<div class="row g-4">
<% if (typeof books !== 'undefined' && books.length > 0) { %>
<% books.forEach(function(book) { %>
<div class="col-md-6 col-lg-4">
<div class="card h-100 shadow-sm border-0 bg-light">
<div class="card-body d-flex flex-column text-center">
<h4 class="card-title text-primary mb-3"><%= book.title %></h4>
<p class="card-text text-muted mb-2">
<strong><%= t.subject %>:</strong> <span class="badge bg-secondary"><%= book.subject %></span>
</p>
<p class="card-text fw-bold text-success fs-5 mb-4">
<%= t.price %>: <%= book.price %> JD
</p>

<a href="/book/<%= book.id %>" class="btn btn-outline-primary mt-auto w-100"><%= t.viewDetails %></a>
</div>
</div>
</div>
<% }); %>
<% } else { %>
<div class="col-12">
<div class="alert alert-info text-center fs-5 shadow-sm" role="alert">
<%= t.noBooksAvailable %>
</div>
</div>
<% } %>
</div>
</div>
<%- include('./partials/footer') %>