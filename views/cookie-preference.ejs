<%- include('./partials/header') %>
<!-- Basic cookie preference page -->
<h1><%= language === 'ar' ? 'تفضيلات الكوكيز' : 'Cookie Preference' %></h1>
<p><%= language === 'ar' ? 'المظهر الحالي: ' : 'Current theme: ' %><%= theme %></p>
<p><%= language === 'ar' ? 'اللغة الحالية: ' : 'Current language: ' %><%= language %></p>
<% if (saved) { %>
<p style="color: green;"><%= language === 'ar' ? 'تم حفظ التفضيلات.' : 'Preferences saved.' %></p>
<% } %>
<form action="/cookie-preference" method="POST">
<div>
<label for="theme"><%= language === 'ar' ? 'المظهر:' : 'Theme:' %></label>
<select id="theme" name="theme">
<option value="light" <%= theme === 'light' ? 'selected' : '' %>><%= language === 'ar' ? 'فاتح' : 'Light' %></option>
<option value="dark" <%= theme === 'dark' ? 'selected' : '' %>><%= language === 'ar' ? 'داكن' : 'Dark' %></option>
</select>
</div>
<div>
<label for="language"><%= language === 'ar' ? 'اللغة:' : 'Language:' %></label>
<select id="language" name="language">
<option value="en" <%= language === 'en' ? 'selected' : '' %>><%= language === 'ar' ? 'إنجليزي' : 'English' %></option>
<option value="ar" <%= language === 'ar' ? 'selected' : '' %>><%= language === 'ar' ? 'عربي' : 'Arabic' %></option>
</select>
</div>
<button type="submit"><%= language === 'ar' ? 'حفظ التفضيلات' : 'Save Preferences' %></button>
</form>
<%- include('./partials/footer') %>
