<%- include('./partials/header') %>
<!-- Personalized dashboard visible only after login -->
<div class="container">
<div class="row mb-4">
<div class="col-12">
<div class="card shadow-sm border-0 bg-white p-4">
<h3 class="text-primary m-0"><%= t.dashboardTitle %> 📖</h3>
<p class="text-muted mb-0"><%= t.dashboardSubtitle %></p>
<p class="text-muted mb-0"><%= t.welcome %>, <%= user ? (user.name || user.username) : t.student %>!</p>
</div>
</div>
</div>
<div class="row g-3">
<div class="col-md-4">
<div class="card shadow-sm text-center h-100 p-3">
<h5 class="card-title"><%= t.submitRequestBook %></h5>
<p class="text-muted small"><%= t.submitRequestDesc %></p>
<button class ="btn btn-success mt-auto" disabled><%= t.newRequestComingSoon %></button>
</div>
</div>
<div class="col-md-4">
<div class="card shadow-sm text-center h-100 p-3">
<h5 class="card-title"><%= t.mySubmissions %></h5>
<p class="text-muted small"><%= t.mySubmissionsDesc %></p>
<h4 class="text-primary my-2"><%= myListedBooksCount + myRequestsCount %> <%= t.totalItems %></h4>
<button class="btn btn-outline-primary mt-auto" disabled><%= t.viewSubmissionsComingSoon %></button>
</div>
</div>
<div class="col-md-4">
<div class="card shadow-sm text-center h-100 p-3">
<h5 class="card-title"><%= t.searchAndBrowse %></h5>
<p class="text-muted small"><%= t.searchAndBrowseDesc %></p>
<a href="/search" class="btn btn-outline-secondary mt-auto"><%= t.searchTextbooks %></a>
</div>
</div>
</div>
</div>
<%- include('./partials/footer') %>