<%- include('./partials/header') %>
<div class="container mt-5 mb-5">
<div class="row justify-content-center">
<div class="col-md-6 col-lg-5">
<div class="card shadow-sm border-0">
<div class="card-header bg-success text-white text-center py-3">
<h4 class="mb-0"><%= t.login %></h4>
</div>
<div class="card-body p-4">
<!-- تحويل سطر الخطأ الأحمر العادي إلى Alert من البوتستراب -->
<% if (error) { %>
<div class="alert alert-danger" role="alert">
<%= error %>
</div>
<% } %>
<form action="/login" method="POST">
<div class="mb-3">
<label for="email" class="form-label fw-bold"><%= t.email %></label>
<input type="email" class="form-control" id="email" name="email" value="<%= typeof email !== 'undefined' ? email : '' %>">
</div>
<div class="mb-4">
<label for="password" class="form-label fw-bold"><%= t.password %></label>
<input type="password" class="form-control" id="password" name="password">
</div>
<button type="submit" class="btn btn-success w-100 py-2"><%= t.login %></button>
</form>
<hr class="my-4">
<div class="text-center">
<p class="mb-0 text-muted"><%= t.dontHaveAccount %> <a href="/register" class="text-success text-decoration-none fw-bold"><%= t.registerHere %></a></p>
</div>
</div>
</div>
</div>
</div>
</div>
<%- include('./partials/footer') %>