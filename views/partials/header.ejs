<!DOCTYPE html>
<html lang="<%= typeof language !== 'undefined' && language === 'ar' ? 'ar' : 'en' %>" dir="<%= typeof language !== 'undefined' && language === 'ar' ? 'rtl' : 'ltr' %>">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Book Library</title>
    

    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/style.css" />
  </head>

  <body class="<%= typeof theme !== 'undefined' && theme === 'dark' ? 'theme-dark' : 'theme-light' %>">
    

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
      <div class="container">
        <a class="navbar-brand" href="/">
          <%= typeof language !== 'undefined' && language === 'ar' ? 'مكتبة الكتب' : 'Book Library' %>
        </a>

        
        <button
          class="navbar-toggler"
          type="button"
          data-bs-toggle="collapse"
          data-bs-target="#mainNavbar"
        >
          <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="mainNavbar">
          <ul class="navbar-nav ms-auto">
            
            
            <li class="nav-item">
              <a class="nav-link <%= typeof currentPage !== 'undefined' && currentPage === 'home' ? 'active' : '' %>" href="/">
                <%= typeof language !== 'undefined' && language === 'ar' ? 'الرئيسية' : 'Home' %>
              </a>
            </li>

            <li class="nav-item">
              <a class="nav-link <%= typeof currentPage !== 'undefined' && currentPage === 'about' ? 'active' : '' %>" href="/about">
                <%= typeof language !== 'undefined' && language === 'ar' ? 'حول' : 'About' %>
              </a>
            </li>

            <li class="nav-item">
              <a class="nav-link <%= typeof currentPage !== 'undefined' && currentPage === 'books' ? 'active' : '' %>" href="/features">
                <%= typeof language !== 'undefined' && language === 'ar' ? 'الكتب' : 'Books' %>
              </a>
            </li>

            <li class="nav-item">
              <a class="nav-link <%= typeof currentPage !== 'undefined' && currentPage === 'search' ? 'active' : '' %>" href="/search">
                <%= typeof language !== 'undefined' && language === 'ar' ? 'بحث' : 'Search' %>
              </a>
            </li>

            <li class="nav-item">
              <a class="nav-link <%= typeof currentPage !== 'undefined' && currentPage === 'cookie' ? 'active' : '' %>" href="/cookie-preference">
                <%= typeof language !== 'undefined' && language === 'ar' ? 'الكوكيز' : 'Cookies' %>
              </a>
            </li>

            <li class="nav-item">
              <a class="nav-link <%= typeof currentPage !== 'undefined' && currentPage === 'login' ? 'active' : '' %>" href="/login">
                <%= typeof language !== 'undefined' && language === 'ar' ? 'تسجيل الدخول' : 'Login' %>
              </a>
            </li>

            <li class="nav-item">
              <a class="nav-link <%= typeof currentPage !== 'undefined' && currentPage === 'register' ? 'active' : '' %>" href="/register">
                <%= typeof language !== 'undefined' && language === 'ar' ? 'التسجيل' : 'Register' %>
              </a>
            </li>

            
            <li class="nav-item">
              <a class="nav-link <%= typeof currentPage !== 'undefined' && currentPage === 'dashboard' ? 'active' : '' %>" href="/dashboard">
                <%= typeof language !== 'undefined' && language === 'ar' ? 'لوحة التحكم' : 'Dashboard' %>
              </a>
            </li>
          </ul>
        </div>
      </div>
    </nav>